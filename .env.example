# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
#   cp .env.example .env

# --- PubMed / NCBI E-utilities (Module 1) ---
# Works without a key at 3 requests/sec; a key raises that to 10/sec.
# Get one at: https://www.ncbi.nlm.nih.gov/account/  (Settings -> API Key Management)
NCBI_API_KEY=
# NCBI asks that you identify yourself so they can contact you before blocking
# a misbehaving script. Required by their usage policy.
NCBI_EMAIL=

# --- LLM provider ---
# Required. Extraction and the orchestrator loop both need this.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5.
ANTHROPIC_MODEL=
